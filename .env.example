# Copy to .env and adjust. .env is git-ignored.
NODE_ENV=development
PORT=3000
# Loopback only by default; there is no login.
# HOST=127.0.0.1
# Other Host header names to answer to (comma separated). Rarely needed.
# ALLOWED_HOSTS=
# Replace USER (and add :PASSWORD if your server needs one). With a default
# Homebrew install, USER is your macOS username.
DATABASE_URL=postgresql://USER@localhost:5432/deadletter_dev

# Optional: tests use this database. It must end in _test. If unset, tests use
# deadletter_test on localhost as your OS user.
# TEST_DATABASE_URL=postgresql://USER@localhost:5432/deadletter_test

# Models. The default "mock" provider needs nothing and is what the tests use.
# A live model is optional and only for demonstrations of arbitrary requests.
# MODEL_PROVIDER=openai_compatible
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_API_KEY=
# PLANNER_MODEL=
# QUARANTINE_MODEL=
