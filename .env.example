# Copy to .env and adjust. .env is git-ignored.
NODE_ENV=development
PORT=3000
# Replace USER (and add :PASSWORD if your server needs one). With a default
# Homebrew install, USER is your macOS username.
DATABASE_URL=postgresql://USER@localhost:5432/deadletter_dev

# Optional: tests use this database. It must end in _test. If unset, tests use
# deadletter_test on localhost as your OS user.
# TEST_DATABASE_URL=postgresql://USER@localhost:5432/deadletter_test
